<xsd:schema xmlns="https://nervousync.org/schemas/startup" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="https://nervousync.org/schemas/startup" elementFormDefault="qualified" version="1.0">
    <xsd:complexType name="launcher_config">
        <xsd:all>
            <xsd:element name="launcher_class" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Implement class name of startup launcher</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="sort_code" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Startup sort code</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="startup_type">
                <xsd:annotation>
                    <xsd:documentation>Enumeration value of startup type</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:enumeration value="AUTO"/>
                        <xsd:enumeration value="MANUAL"/>
                        <xsd:enumeration value="DISABLE"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
        </xsd:all>
    </xsd:complexType>
    <xsd:element name="launcher_config" type="launcher_config" />
    <xsd:element name="startup_config">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="last_modify" type="xsd:long">
                    <xsd:annotation>
                        <xsd:documentation>Last modify time milliseconds</xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
                <xsd:element name="registered_launchers" minOccurs="0">
                    <xsd:annotation>
                        <xsd:documentation>Custom secure configure information list</xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element ref="launcher_config" minOccurs="0" maxOccurs="unbounded">
                                <xsd:annotation>
                                    <xsd:documentation>Custom secure configure information</xsd:documentation>
                                </xsd:annotation>
                            </xsd:element>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>
</xsd:schema>